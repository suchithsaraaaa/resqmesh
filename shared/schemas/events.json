{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ResQMeshEventHeader",
  "type": "object",
  "required": ["uuid", "eventType", "createdAt", "deviceId", "deviceClock"],
  "properties": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "description": "Globally unique identifier for the event record"
    },
    "eventType": {
      "type": "string",
      "enum": [
        "incident_created",
        "chat_message",
        "status_update",
        "resource_request",
        "sync_ack",
        "ai_analysis"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 UTC timestamp of creation"
    },
    "deviceId": {
      "type": "string",
      "description": "Unique identifier / public key hash of the originating device"
    },
    "deviceClock": {
      "type": "integer",
      "minimum": 0,
      "description": "Monotonic counter for logical clock synchronization"
    },
    "payload": {
      "type": "object",
      "description": "Event-specific data body"
    }
  }
}
