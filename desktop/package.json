{
  "name": "resqmesh-desktop",
  "productName": "ResQMesh AI",
  "version": "1.0.33",
  "description": "Offline Emergency Response Platform with Distributed Mesh Networking & AI Decision Support",
  "author": "ResQMesh AI Team",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "start": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "electron:start": "electron .",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@types/three": "^0.185.4",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^5.24.0",
    "pmtiles": "^4.5.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.8",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "typescript": "^5.2.2",
    "vite": "^5.0.8"
  },
  "build": {
    "appId": "com.resqmesh.app",
    "productName": "ResQMesh AI",
    "asar": true,
    "directories": {
      "output": "../release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/resqmesh-server",
        "to": "resqmesh-server",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../backend/app/rag",
        "to": "rag",
        "filter": [
          "index/**/*",
          "metadata/**/*",
          "manifest.json",
          "knowledge_base_report.json",
          "documents/**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "ResQMeshAI-Setup-v${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "ResQMesh AI",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "uninstallDisplayName": "ResQMesh AI",
      "include": "build/installer.nsh"
    }
  }
}
