{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "lib": ["ES2020", "DOM"],
    "skipLibCheck": true,
    "moduleResolution": "node",
    "noImplicitAny": false,
    "jsx": "react",
    "strict": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "typeRoots": ["../mobile/node_modules/@types"],
    "baseUrl": ".",
    "paths": {
      "react": ["../mobile/node_modules/@types/react"]
    }
  },
  "include": ["src/**/*"]
}
